# Supabase (optional — app runs in offline mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Drand (optional — defaults to https://api.drand.sh)
NEXT_PUBLIC_Drand_URL=https://api.drand.sh

# Google Analytics 4 (Phase 2) — leave empty to disable tracking
NEXT_PUBLIC_GA_ID=

# Site URL (canonical base). Defaults to https://tomorrowme.net (Phase 6
# domain cutover). Set to https://ure.one while staging on the temp domain.
NEXT_PUBLIC_SITE_URL=https://tomorrowme.net
